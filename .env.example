# Public base URL used for canonical URLs, hreflang, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.sengolgroup.com

# ---- Enquiry delivery (configure at least one, otherwise forms report "not configured") ----

# Option A: Resend (https://resend.com) transactional email API
RESEND_API_KEY=
# Inbox(es) that receive enquiries, comma separated
ENQUIRY_TO_EMAIL=network@sengolgroup.com,bdm@sengolgroup.com
# Verified sender on your Resend domain, e.g. "Sengol Website <website@sengolgroup.com>"
ENQUIRY_FROM_EMAIL=

# Option B: HTTPS webhook (CRM, Zapier, Make, n8n ...). Receives JSON { type, locale, submittedAt, data }
ENQUIRY_WEBHOOK_URL=
# Optional shared secret sent as the "X-Webhook-Secret" header
ENQUIRY_WEBHOOK_SECRET=
