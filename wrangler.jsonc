{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "main-website",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding: the service name must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "main-website"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Both hostnames serve the site. Cloudflare creates the DNS records and
  // certificates for custom domains on deploy.
  "routes": [
    { "pattern": "sengolgroup.com", "custom_domain": true },
    { "pattern": "www.sengolgroup.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
