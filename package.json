    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@opennextjs/cloudflare": "1.20.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotted-map": "3.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
